# cave.world
# simple cave environment with a pioneer robot based on the basic world file examples of 
# Richard Vaughan Richard Vaughan, Andrew Howard, Luis Riazuelo
# Authors: Markus Bader

include "include/robots.inc"

seed 0  # 0 usually tells Stage to use a random seed from the system clock

# set the resolution of the underlying raytrace model in meters
resolution 0.02

# simulation timestep in milliseconds
interval_sim 100  

define floorplan model
(
  # sombre, sensible, artistic
  color "gray30"

  # most maps will need a bounding box
  boundary 1

  gui_nose 0
  gui_grid 0

  gui_outline 0
  gripper_return 0
  fiducial_return 0
  laser_return 1
)

# configure the GUI window
window
(
  size [ 635.000 666.000 ] # in pixels
  scale 36.995   # pixels per meter
  center [ -0.040  -0.274 ]
  rotate [ 0  0 ]

  show_data 1              # 1=on 0=off
)

# load an environment bitmap
floorplan
( 
  name "cave"
  size [16.000 16.000 0.800]
  pose [0 0 0 0]
  bitmap "bitmaps/cave_filled.png"
  gui_move 0
)

# define a block
define my_block model
(
  size [0.5 0.5 0.5]
  gui_nose 0
)

# define a block
define mount model
(
  size [0.02 0.02 0.5]
  gui_nose 0
)

# Add this to the bottom of your .world file
my_block 
( 
  name "tag_1" 
  color "green" 
  pose [ -5 -5 0 0 ] 
  fiducial_return 10  # This is the ID the robot will detect
)

my_block 
( 
  name "tag_2" 
  color "blue" 
  pose [ -5 1 0 0 ] 
  fiducial_return 20  # Another unique ID
)

my_block 
( 
  name "tag_3" 
  color "blue" 
  pose [ -2 7.2 0 0 ] 
  fiducial_return 30  # Another unique ID
)

my_block 
( 
  name "tag_4" 
  color "blue" 
  pose [ -1 3.1 0 0 ] 
  fiducial_return 40  # Another unique ID
)

my_block 
( 
  name "tag_5" 
  color "blue" 
  pose [ -1 -1 0 0 ] 
  fiducial_return 50  # Another unique ID
)



# throw in a robot
pioneer2dx_with_laser_and_fiducial 
(
  name "robot_0"
  color "red" 
  drive "diff"
  pose [ -7 -7 0 90 ] 
)